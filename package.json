{
  "name": "chainos-control-tower",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone ChainOS Phase 1 supply control tower",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "test": "node scripts/validate.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-database.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-database.mjs",
    "db:import": "node --env-file-if-exists=.env scripts/import-snapshot.mjs",
    "db:history": "node --env-file-if-exists=.env scripts/snapshot-revisions.mjs list",
    "db:restore": "node --env-file-if-exists=.env scripts/snapshot-revisions.mjs restore"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
